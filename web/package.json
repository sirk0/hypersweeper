{
  "name": "hypersweeper-web",
  "private": true,
  "version": "0.3.32",
  "license": "MIT",
  "type": "module",
  "description": "TypeScript + Three.js rewrite of the Hypersweeper game (M0 scaffold).",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.functions.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "e2e:docker": "docker compose -f docker-compose.e2e.yml run --rm --build e2e",
    "e2e:docker:update": "npm run e2e:docker -- --update-snapshots",
    "icons": "vite-node scripts/make-icons.mts",
    "screenshots": "vite-node scripts/make-screenshots.mts",
    "store-screenshots": "vite-node scripts/make-store-screenshots.mts",
    "stickers": "vite-node scripts/make-stickers.mts",
    "gamecenter": "vite-node scripts/make-gamecenter.mts",
    "og": "vite-node scripts/make-og-image.mts"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.1",
    "@types/three": "^0.171.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.1.0"
  }
}
