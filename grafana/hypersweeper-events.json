    {
      "type": "table",
      "id": 3,
      "title": "Every event, every column",
      "description": "One row per reported event — a `start` when a board opens, an `end` on the move that finishes it. This is the raw dataset: index1, blob1..12, double1..11 and _sample_interval, under the names in docs/agents/metrics.md. Newest first, capped by the Rows variable.",
      "gridPos": {
        "h": 24,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${ds}"
          },
          "format": "table",
          "editorMode": "sql",
          "query": "SELECT\n  toUInt32(timestamp) * 1000 AS t,\n  index1   AS mode,\n  blob1    AS kind,\n  blob2    AS difficulty,\n  blob3    AS outcome,\n  blob4    AS board,\n  blob5    AS tiling,\n  blob6    AS surface,\n  blob7    AS family,\n  blob8    AS trigger,\n  blob9    AS from_state,\n  blob10   AS device,\n  blob11   AS shell,\n  blob12   AS version,\n  double1  AS seconds,\n  double2  AS cells,\n  double3  AS mines,\n  double4  AS opened,\n  double5  AS flags_right,\n  double6  AS flags_wrong,\n  double7  AS reveals,\n  double8  AS chords,\n  double9  AS flag_moves,\n  double10 AS first_move_ms,\n  double11 AS view_moved,\n  _sample_interval AS sample_interval\nFROM hypersweeper_game_events\nWHERE timestamp >= toDateTime(${__from:date:seconds})\n  AND timestamp <= toDateTime(${__to:date:seconds})\n  AND ('$difficulty' = 'all' OR blob2  = '$difficulty')\n  AND ('$surface'    = 'all' OR blob6  = '$surface')\n  AND ('$family'     = 'all' OR blob7  = '$family')\n  AND ('$device'     = 'all' OR blob10 = '$device')\n  AND ('$shell'      = 'all' OR blob11 = '$shell')\n  AND ('$kind'    = 'all' OR blob1  = '$kind')\n  AND ('$outcome' = 'all' OR blob3  = '$outcome')\n  AND ('$mode'    = ''    OR index1 = '$mode')\n  AND ('$version' = ''    OR blob12 = '$version')\nORDER BY t DESC\nLIMIT $limit",
          "database": "",
          "table": "",
          "dateTimeType": "DATETIME",
          "dateColDataType": "",
          "dateTimeColDataType": "timestamp",
          "extrapolate": false,
          "skip_comments": true,
          "add_metadata": false,
          "round": "0s",
          "intervalFactor": 1,
          "interval": "",
          "adHocFilters": []
        }
      ],
