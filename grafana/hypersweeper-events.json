  "description": "Every column the deployed game reports, one row per event. The explorer — start here when a number on another dashboard looks wrong. Schema: docs/agents/metrics.md.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "id": 2,
      "title": "Events in range",
      "description": "Counts are SUM(_sample_interval), never COUNT(*) — Analytics Engine stores a sample and each stored row stands for _sample_interval real events. 'Stored rows' is the unweighted row count, shown only so the sampling ratio is visible. Every number is a floor.",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${ds}"
          },
          "format": "table",
          "editorMode": "sql",
          "query": "SELECT\n  sum(if(blob1 = 'start', _sample_interval, 0)) AS started,\n  sum(if(blob1 = 'end',   _sample_interval, 0)) AS finished,\n  sum(_sample_interval)                         AS events,\n  count()                                       AS stored_rows\nFROM hypersweeper_game_events\nWHERE timestamp >= toDateTime(${__from:date:seconds})\n  AND timestamp <= toDateTime(${__to:date:seconds})\n  AND ('$difficulty' = 'all' OR blob2  = '$difficulty')\n  AND ('$surface'    = 'all' OR blob6  = '$surface')\n  AND ('$family'     = 'all' OR blob7  = '$family')\n  AND ('$device'     = 'all' OR blob10 = '$device')\n  AND ('$shell'      = 'all' OR blob11 = '$shell')\n  AND ('$kind'    = 'all' OR blob1  = '$kind')\n  AND ('$outcome' = 'all' OR blob3  = '$outcome')\n  AND ('$mode'    = ''    OR index1 = '$mode')\n  AND ('$version' = ''    OR blob12 = '$version')",
          "database": "",
          "table": "",
          "dateTimeType": "DATETIME",
          "dateColDataType": "",
          "dateTimeColDataType": "timestamp",
          "extrapolate": false,
          "skip_comments": true,
          "add_metadata": false,
          "round": "0s",
          "intervalFactor": 1,
          "interval": "",
          "adHocFilters": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "started"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Games started"
              }
            ]
          },
          {
            "matcher": {
