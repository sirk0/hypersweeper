      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${ds}"
          },
          "format": "table",
          "editorMode": "sql",
          "query": "SELECT\n  blob8 AS trigger,\n  blob9 AS from_state,\n  sum(_sample_interval) AS starts\nFROM hypersweeper_game_events\nWHERE timestamp >= toDateTime(${__from:date:seconds})\n  AND timestamp <= toDateTime(${__to:date:seconds})\n  AND blob1 = 'start'\n  AND blob4 != ''\n  AND ('$difficulty' = 'all' OR blob2  = '$difficulty')\n  AND ('$surface'    = 'all' OR blob6  = '$surface')\n  AND ('$family'     = 'all' OR blob7  = '$family')\n  AND ('$device'     = 'all' OR blob10 = '$device')\n  AND ('$shell'      = 'all' OR blob11 = '$shell')\nGROUP BY trigger, from_state\nORDER BY starts DESC",
          "database": "",
          "table": "",
          "dateTimeType": "DATETIME",
