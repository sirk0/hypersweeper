    {
      "type": "table",
      "id": 3,
      "title": "Plays, wins and win rate per board",
      "description": "The report `make metrics` prints, as a panel. 'Abandoned' is plays − finished. Boards with fewer finished games than the Min finished variable are dropped, because a win rate over three games is noise. 0.2.83 and later only — see Overview & trends → Schema coverage for how much of the range that leaves out.",
      "gridPos": {
        "h": 13,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${ds}"
          },
          "format": "table",
          "editorMode": "sql",
          "query": "SELECT\n  blob4 AS board,\n  sum(if(blob1 = 'start', _sample_interval, 0)) AS plays,\n  sum(if(blob1 = 'end', _sample_interval, 0))   AS finished,\n  sum(if(blob1 = 'start', _sample_interval, 0)) - sum(if(blob1 = 'end', _sample_interval, 0)) AS abandoned,\n  sum(if(blob1 = 'end' AND blob3 = 'won', _sample_interval, 0))   AS won,\n  sum(if(blob1 = 'end' AND blob3 = 'lost', _sample_interval, 0))  AS lost,\n  sum(if(blob1 = 'end' AND blob3 = 'won', _sample_interval, 0)) / sum(if(blob1 = 'end', _sample_interval, 0)) AS win_rate,\n  sum(if(blob1 = 'end', double1 * _sample_interval, 0.0)) / sum(if(blob1 = 'end', _sample_interval, 0)) AS mean_seconds\nFROM hypersweeper_game_events\nWHERE timestamp >= toDateTime(${__from:date:seconds})\n  AND timestamp <= toDateTime(${__to:date:seconds})\n  AND blob4 != ''\n  AND ('$difficulty' = 'all' OR blob2  = '$difficulty')\n  AND ('$surface'    = 'all' OR blob6  = '$surface')\n  AND ('$family'     = 'all' OR blob7  = '$family')\n  AND ('$device'     = 'all' OR blob10 = '$device')\n  AND ('$shell'      = 'all' OR blob11 = '$shell')\nGROUP BY board\nHAVING sum(if(blob1 = 'end', _sample_interval, 0)) >= $min\nORDER BY plays DESC",
          "database": "",
          "table": "",
          "dateTimeType": "DATETIME",
          "dateColDataType": "",
          "dateTimeColDataType": "timestamp",
          "extrapolate": false,
          "skip_comments": true,
          "add_metadata": false,
          "round": "0s",
          "intervalFactor": 1,
          "interval": "",
          "adHocFilters": []
        }
      ],
      "fieldConfig": {
        "defaults": {
