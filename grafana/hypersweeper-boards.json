    {
      "type": "table",
      "id": 8,
      "title": "How games get started",
      "description": "trigger × from — what dealt the board, and what the previous board was doing. A re-roll from the win card is random/won; the smiley after a loss is again/lost; a mid-board re-roll is random/playing; a menu pick or a shared link has no previous board.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 37
      },
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
