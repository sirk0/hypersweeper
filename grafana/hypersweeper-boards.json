          },
          "format": "table",
          "editorMode": "sql",
          "query": "SELECT\n  blob6 AS surface,\n  sum(double4 * _sample_interval) / sum(double2 * _sample_interval) AS opened_fraction,\n  sum(_sample_interval) AS losses\nFROM hypersweeper_game_events\nWHERE timestamp >= toDateTime(${__from:date:seconds})\n  AND timestamp <= toDateTime(${__to:date:seconds})\n  AND blob1 = 'end' AND blob3 = 'lost'\n  AND double2 > 0\n  AND blob4 != ''\n  AND ('$difficulty' = 'all' OR blob2  = '$difficulty')\n  AND ('$surface'    = 'all' OR blob6  = '$surface')\n  AND ('$family'     = 'all' OR blob7  = '$family')\n  AND ('$device'     = 'all' OR blob10 = '$device')\n  AND ('$shell'      = 'all' OR blob11 = '$shell')\nGROUP BY surface\nORDER BY opened_fraction DESC",
          "database": "",
          "table": "",
          "dateTimeType": "DATETIME",
          "dateColDataType": "",
          "dateTimeColDataType": "timestamp",
          "extrapolate": false,
          "skip_comments": true,
