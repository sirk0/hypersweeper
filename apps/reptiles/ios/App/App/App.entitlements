<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- iCloud's key-value store, where the stars are kept in step across the
     player's iPhone and iPad (CloudRecordPlugin.swift, src/cloudStars.ts).
     Automatic signing adds the capability to the App ID on the first archive. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)io.github.sirk0.reptiles</string>
</dict>
</plist>
