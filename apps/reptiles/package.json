{
  "name": "rep-tiles",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "description": "Rep-tiles: cover a region with tiles by drag and drop. Built on the shared board geometry (@tiling/geometry, packages/geometry).",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "difficulty": "vite-node scripts/measure-difficulty.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tiling/data": "*",
    "@tiling/geometry": "*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
