{
  "name": "rep-tiles",
  "private": true,
  "version": "0.4.64",
  "license": "MIT",
  "type": "module",
  "description": "Rep-tiles: cover a region with tiles by drag and drop. Built on the shared board geometry (@tiling/geometry, packages/geometry).",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "colourings": "vite-node scripts/find-colourings.mts",
    "levels": "vite-node scripts/index-levels.mts",
    "difficulty": "vite-node scripts/measure-difficulty.mts",
    "boards": "vite-node scripts/find-boards.mts",
    "marked-boards": "vite-node scripts/find-marked-boards.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "vite-node scripts/make-icons.mts",
    "e2e": "playwright test",
    "store-screenshots": "vite-node scripts/make-store-screenshots.mts"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@tiling/data": "*",
    "@tiling/geometry": "*",
    "@tiling/native": "*",
    "@tiling/platform": "*",
    "@tiling/sound": "*"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@playwright/test": "1.63.0",
    "@tiling/vite-preset": "*",
    "@types/node": "^22.20.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.1.0"
  }
}
