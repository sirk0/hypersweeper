require_relative '../../web/node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '18.0'
use_frameworks!

# Let CocoaPods declare input/output file lists for its script phases, so
# Xcode can skip "Embed Pods Frameworks" when nothing changed (the alternative
# is a build warning on every run). `pod install` regenerates the lists
# whenever a plugin is added.
install! 'cocoapods', :disable_input_output_paths => false

def capacitor_pods
  pod 'Capacitor', :path => '../../web/node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../web/node_modules/@capacitor/ios'
  pod 'CapacitorHaptics', :path => '../../web/node_modules/@capacitor/haptics'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
end

# The App Clip (AppClip/) runs the same game in the same Capacitor bridge, so
# it links the same pods. `cap sync` rewrites only `capacitor_pods` above, so a
# new plugin reaches both targets.
target 'AppClip' do
  capacitor_pods
end

post_install do |installer|
  assertDeploymentTarget(installer)

  # The pods' own podspecs ask for an older iOS than the app (Capacitor's
  # floor is 15), and current Xcode SDKs no longer build for iOS 14. Match the
  # app target.
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '18.0'
      # The pods are Capacitor's code, not ours: its deprecation and
      # concurrency warnings are not ours to fix, so keep them out of the log.
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
    end
  end
end
