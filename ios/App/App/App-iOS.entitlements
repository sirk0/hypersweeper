<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- iPhone and iPad only (CODE_SIGN_ENTITLEMENTS[sdk=iphone*]); the Mac build
     signs with App.entitlements. Names the App Clip that ships inside this
     app (ios/App/AppClip), which names this app back, turns on Game
     Center, where the achievements are reported (GameCenterPlugin.swift),
     and iCloud key-value storage, where the best times and the achievement
     record are kept in step (CloudRecordPlugin.swift). The store is named
     outright rather than after $(CFBundleIdentifier) so it is the same one
     App.entitlements names for the Mac. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.game-center</key>
	<true/>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)io.github.sirk0.hypersweeper</string>
	<key>com.apple.developer.associated-appclip-app-identifiers</key>
	<array>
		<string>$(AppIdentifierPrefix)io.github.sirk0.hypersweeper.Clip</string>
	</array>
</dict>
</plist>
