    "test:watch": "vitest",
    "difficulty": "vite-node scripts/measure-difficulty.mts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
